{
  "name": "caret-control",
  "version": "0.7.0-beta.3",
  "description": "Move the text caret on Steam Deck with controller shoulder buttons and the right stick.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "check": "tsc --noEmit",
    "test": "tsc --noEmit && rollup -c",
    "package-plugin": "python scripts/package_plugin.py"
  },
  "keywords": [
    "decky",
    "plugin",
    "caret",
    "keyboard",
    "accessibility",
    "steam-deck",
    "deck"
  ],
  "author": "WooVS",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
